{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 .cursor/hooks/session_bind.py"
      }
    ],
    "beforeReadFile": [
      {
        "command": "python3 .cursor/hooks/session_bind.py",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/session_bind.py",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "python3 .cursor/hooks/session_bind.py",
        "matcher": "Shell"
      }
    ]
  }
}
