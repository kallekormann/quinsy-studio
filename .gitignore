# =============================================================================
# Quinsy Studio — .gitignore
# =============================================================================

# =============================================================================
# NUR DAS STUDIO COMMITTEN — NIEMALS PROJEKTE ODER INTAKE
# =============================================================================
# Das Repo enthält ausschließlich das Studio-HQ (.quinsy-studio/, studio, ...).
# Projekte (projects/) und rohe Intake-Ideen (intake/) sind lokale Arbeit und
# gehören NICHT in den Studio-Repository. Projekt-Code hat sein eigenes Repo.
projects/
# Raw intake stays local. The amendment example is studio-templates/amendment_01.example.md.
intake/

# Ideation desk notes stay local, like intake PRDs.
# The seed templates live in .quinsy-studio/studio-templates/ideation/ and are committed.
/ideation/

# Externe Skills: geklonte Repos (65MB+, regenerierbar via `./studio update-skills`)
# Nur die skill-dependencies.json ist die Source of Truth.
.quinsy-studio/external-skills/

# Local agent session (regenerated via ./studio focus)
.quinsy-studio/.active-project.json
.quinsy-studio/.session-usage.json
.quinsy-studio/studio.settings.local.yaml
.quinsy-studio/.secrets/
.cursorignore
.cursor/rules/quinsy-project-isolation.mdc

# Durable Playwright browsers for gate smoke (LO-0052)
.quinsy-studio/.cache/

# Python
__pycache__/
*.pyc
*.pyo

# Node (Projekt-Builds)
node_modules/
.next/
dist/
build/
*.tsbuildinfo

# macOS
.DS_Store

# IDE
.freebuff/
.idea/
.vscode/
*.swp

# Secrets & Env
.env
.env.local
.env.*.local
*.pem
*.key

# Logs
*.log
npm-debug.log*
