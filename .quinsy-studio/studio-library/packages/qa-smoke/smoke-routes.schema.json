{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Smoke routes config",
  "type": "object",
  "required": ["routes"],
  "properties": {
    "description": { "type": "string" },
    "host": { "type": "string", "default": "127.0.0.1" },
    "port": { "type": "integer", "default": 3456 },
    "baseUrl": { "type": "string", "description": "Override full base URL (else http://host:port)" },
    "startCwd": { "type": "string", "default": "." },
    "startCommand": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Spawn argv; {port} and {host} are substituted"
    },
    "env": { "type": "object", "additionalProperties": { "type": "string" } },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string" },
          "expectText": { "type": "string" },
          "expectSelector": { "type": "string" },
          "waitForUrl": {
            "type": "string",
            "description": "RegExp source matched against page.url()"
          }
        }
      }
    }
  }
}
