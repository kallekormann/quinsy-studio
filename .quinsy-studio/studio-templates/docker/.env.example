# Seed for projects/<name>/.env. Do not put live passwords in git. Production: Coolify.
# Names: ../../studio-templates/env.schema.json

# Project
PROJECT_NAME={{PROJECT_NAME}}

# Database (host port — probe first; see knowledge-base/host-port-allocation.md)
POSTGRES_HOST_PORT=15432
POSTGRES_DB={{PROJECT_NAME}}
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Redis
REDIS_HOST_PORT=16379
REDIS_URL=

# App (when using app service)
# APP_HOST_PORT=13000
# DATABASE_URL=
# NODE_ENV=development
