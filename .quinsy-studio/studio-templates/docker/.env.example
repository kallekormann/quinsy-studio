# Seed for projects/<name>/.env. Do not put live passwords in git. Production: Coolify.
# Names: ../../studio-templates/env.schema.json

# Project
PROJECT_NAME={{PROJECT_NAME}}

# Database (host port — probe first; see knowledge-base/host-port-allocation.md)
POSTGRES_HOST_PORT=15432
POSTGRES_DB={{PROJECT_NAME}}
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Redis
REDIS_HOST_PORT=16379
REDIS_URL=

# App (Payload, after gate 1)
APP_HOST_PORT=13000
DATABASE_URL=
NODE_ENV=development
PAYLOAD_SECRET=
RESEND_API_KEY=
RESEND_FROM=

# Optional profiles: redis, pooler, minio, rag
PGBOUNCER_HOST_PORT=15433
MINIO_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=

# Payments (names only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
