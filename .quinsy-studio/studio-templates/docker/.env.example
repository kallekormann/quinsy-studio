# Quinsy Studio — Docker environment template
# Copy to .env and customize (parameterized automatically during project init)

# Project
PROJECT_NAME={{PROJECT_NAME}}

# Database (host port — probe first; see knowledge-base/host-port-allocation.md)
POSTGRES_HOST_PORT=15432
POSTGRES_DB={{PROJECT_NAME}}
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_HOST_PORT=16379
REDIS_URL=redis://localhost:16379

# App (when using app service)
# APP_HOST_PORT=13000
# DATABASE_URL=postgresql://postgres:postgres@localhost:15432/{{PROJECT_NAME}}
# NODE_ENV=development
