# Quinsy Studio — Docker Environment Template
# Copy to .env and customize (wird beim Projekt-Init automatisch parametrisiert)

# Project
PROJECT_NAME={{PROJECT_NAME}}

# Database
POSTGRES_DB={{PROJECT_NAME}}
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379

# App (when using app service)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/{{PROJECT_NAME}}
# NODE_ENV=development
